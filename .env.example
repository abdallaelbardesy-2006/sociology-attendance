# معرّف ملف جوجل شيت (من رابط الملف)
GOOGLE_SHEET_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# حساب الخدمة (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=service@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# المشرف العام الوحيد + كلمة مرور أولية (يُطلب تغييرها عند أول دخول)
ADMIN_EMAIL=you@example.com
ADMIN_SECRET_KEY=change-me-strong-initial-password

# أسرار عشوائية طويلة (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=
QR_SECRET=
